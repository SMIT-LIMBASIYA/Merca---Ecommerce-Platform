# ============================================================================
# Git Ignore Configuration - Merca Platform
# ============================================================================

# Dependencies
node_modules/
**/node_modules/

# Production Builds
dist/
dist-ssr/
build/
out/
.vite/
vite.config.*.timestamp-*

# Environment & Sensitive Files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
**/.env
**/.env.*

# Keep Example Templates in Git
!.env.example
!**/.env.example

# Logs & Diagnostics
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Caches & Temp
.cache/
.tmp-*
.temp/
*.tsbuildinfo

# OS Metadata
.DS_Store
Thumbs.db
ehthumbs.db

# Editor / IDE artifacts
.idea/
*.sublime-project
*.sublime-workspace

# Agent & Figma Cache
.claude-replay.*
/.figma/design-context/
/.plugins/
/.opencode-skills/
