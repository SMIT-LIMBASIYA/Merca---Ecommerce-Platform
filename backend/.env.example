# ============================================================================
# Merca Backend Environment Configuration Template
# ============================================================================

PORT=5000
NODE_ENV=development

# PostgreSQL Connection String (Supabase, Neon, Local, etc.)
DATABASE_URL=postgresql://postgres:password@localhost:5432/merca_db

# Redis Connection (Local or Upstash Cloud)
REDIS_URL=redis://localhost:6379

# 2-Step Login Gate: Secret Access Password
LOGIN_SECRET_PASSCODE=MERCA_SECURE_2026

# Future Email OTP toggle
OTP_ENABLED=false

# Security & Tokens
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
COOKIE_SECRET=your_cookie_secret_here

# CORS
CLIENT_URL=http://localhost:5173
